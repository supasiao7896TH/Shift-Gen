{
  "rules": [
    { "id": "@secretlint/secretlint-rule-preset-recommend" },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          { "name": "Google / Gemini API key", "pattern": "/AIza[0-9A-Za-z_-]{35}/g" },
          {
            "name": "Private key block",
            "pattern": "/-----BEGIN[ A-Z]*PRIVATE KEY( BLOCK)?-----/g"
          },
          {
            "name": "Google service account JSON",
            "pattern": "/\"type\"\\s*:\\s*\"service_account\"/g"
          },
          { "name": "AWS access key id", "pattern": "/\\b(AKIA|ASIA)[0-9A-Z]{16}\\b/g" },
          {
            "name": "Firebase web API key assignment",
            "pattern": "/apiKey\\s*:\\s*[\"'][A-Za-z0-9_-]{20,}[\"']/g"
          }
        ]
      }
    }
  ]
}
