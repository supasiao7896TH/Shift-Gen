# set -e สำคัญมาก: ถ้าไม่มี exit code ของ hook จะเป็นของ "คำสั่งสุดท้าย" เท่านั้น
# คำสั่งก่อนหน้าที่ล้มเหลวจะถูกกลืนหายไป และ commit จะผ่านทั้งที่ gate แดง
set -e

# hook นี้ต้องเร็ว — เกิน ~5 วินาทีเมื่อไหร่ จะเริ่มมีคนพิมพ์ --no-verify
# Playwright (ต้อง build ก่อนด้วย) จึงไม่อยู่ในนี้ ปล่อยให้ CI รัน
npx lint-staged
npx vitest run --silent
